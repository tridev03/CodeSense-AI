# ════════════════════════════════════════════════════════════════════════════
#  AI Software Engineering Knowledge Agent — Environment Configuration Template
#  Phases 1–8 Complete
#
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to source control.
#
#  Generate SECRET_KEY:
#    python -c "import secrets; print(secrets.token_hex(32))"
# ════════════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="AI Knowledge Agent"
# Options: development | production | testing
ENVIRONMENT=development
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Replace with a real random 32+ char hex string in production
SECRET_KEY=change-me-generate-a-real-secret-key-at-least-32-chars

# ─── API / CORS ───────────────────────────────────────────────────────────────
# Add your frontend origin when Phase 9 (Next.js UI) is running
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Start locally: docker compose -f docker/docker-compose.yml up -d
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_knowledge_agent

# ─── Qdrant Vector Database ───────────────────────────────────────────────────
# Start locally: also started by docker compose above
QDRANT_URL=http://localhost:6333
# Leave empty for local Qdrant. Fill in for Qdrant Cloud.
QDRANT_API_KEY=

# ─── LLM — Groq ───────────────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
# Recommended models: qwen/qwen3.8-27b | llama-3.3-70b-versatile | llama3-8b-8192
GROQ_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ─── Embeddings — Qwen3-Embedding-0.6B ────────────────────────────────────────
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Options: cpu | cuda | mps   — auto-fallback to cpu when CUDA unavailable
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# Qwen3-Embedding-0.6B outputs 1024-dim vectors
EMBEDDING_DIMENSION=1024

# ─── Reranking — BGE Cross-Encoder ────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-base
# Options: cpu | cuda | mps   — auto-fallback to cpu when CUDA unavailable
RERANKER_DEVICE=cpu

# ─── Repository Ingestion ─────────────────────────────────────────────────────
# Required for private repos; boosts GitHub API rate limit (5000/hr vs 60/hr)
# Create at: https://github.com/settings/tokens (scopes: repo, read:org)
GITHUB_TOKEN=ghp_your_github_token_here
MAX_FILE_SIZE_MB=5.0
MAX_REPO_SIZE_MB=500.0
REPOS_STORAGE_PATH=./storage/repos

# ─── Retrieval Defaults ───────────────────────────────────────────────────────
# Number of candidates fetched before reranking
TOP_K_RETRIEVAL=20
# Final top-K returned after cross-encoder reranking
TOP_K_RERANK=5
# Options: vector_only | bm25_only | hybrid
RETRIEVAL_MODE=hybrid

# ─── Langfuse Observability (Phase 8) ─────────────────────────────────────────
# Optional — if left empty, tracing runs in silent no-op mode (no performance impact)
# Free account at: https://langfuse.com/
# Dashboard: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Redis & Distributed Queue (Workstream 2: REL-01 Part 2) ───────────────────
# Optional — when configured, background ingestion jobs use Redis & Celery
# instead of the in-process async worker queue. Leave empty to use local mode.
REDIS_URL=redis://localhost:6379/0
CELERY_CONCURRENCY=2
CELERY_TASK_SOFT_TIMEOUT_S=3600
CELERY_TASK_HARD_TIMEOUT_S=7200

