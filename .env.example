# ════════════════════════════════════════════════════════════════════════════
#  AI Software Engineering Knowledge Agent — Environment Template
#  Copy this file to `.env` and fill in all required values.
#
#  NEVER commit `.env` to source control — it contains secrets.
#  Generate a real SECRET_KEY with:
#    python -c "import secrets; print(secrets.token_hex(32))"
# ════════════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="AI Knowledge Agent"
# Options: development | production | testing
ENVIRONMENT=development
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# REQUIRED: Replace with a real 32+ character random secret
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32

# ─── API / CORS ───────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Local dev: start with docker compose -f docker/docker-compose.yml up -d
DATABASE_URL=postgresql://postgres:CHANGE_ME_password@localhost:5432/ai_knowledge_agent

# ─── Qdrant Vector Database ───────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Leave empty for local Qdrant (no auth). Fill in for Qdrant Cloud.
QDRANT_API_KEY=

# ─── LLM — Groq ───────────────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com/
GROQ_API_KEY=CHANGE_ME_gsk_your_groq_api_key_here
# Working model options: qwen/qwen3.8-27b | llama-3.3-70b-versatile
GROQ_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ─── Embeddings — Qwen3-Embedding-0.6B ────────────────────────────────────────
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Options: cpu | cuda | mps   — auto-fallback to cpu if CUDA unavailable
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32
# Qwen3-Embedding-0.6B outputs 1024-dim vectors
EMBEDDING_DIMENSION=1024

# ─── Reranking — BGE Cross-Encoder ────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-base
# Options: cpu | cuda | mps   — auto-fallback to cpu if CUDA unavailable
RERANKER_DEVICE=cuda

# ─── Repository Ingestion ─────────────────────────────────────────────────────
# GitHub Personal Access Token — required for private repos,
# boosts API rate limits for public repos (5000 req/hr vs 60 req/hr)
# Create at: https://github.com/settings/tokens (scopes: repo, read:org)
GITHUB_TOKEN=
MAX_FILE_SIZE_MB=5.0
MAX_REPO_SIZE_MB=500.0
REPOS_STORAGE_PATH=./storage/repos

# ─── Retrieval Defaults ───────────────────────────────────────────────────────
# Number of candidates fetched before reranking
TOP_K_RETRIEVAL=5
# Final top-K returned after cross-encoder reranking
TOP_K_RERANK=5
# Options: vector_only | bm25_only | hybrid
RETRIEVAL_MODE=hybrid

# ─── Redis / Celery ───────────────────────────────────────────────────────────
# Redis connection URL (required for Docker Compose deployment)
REDIS_URL=redis://localhost:6379/0
# Worker concurrency — set to 1 for GPU/memory-constrained machines
CELERY_CONCURRENCY=1

# ─── Langfuse Observability (Optional) ────────────────────────────────────────
# Create a free account at: https://langfuse.com/
# Leave empty to disable tracing (no performance impact)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST="https://cloud.langfuse.com"
